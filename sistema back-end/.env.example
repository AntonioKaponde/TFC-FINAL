# ============================================
# Configuração do Backend
# ============================================

# Perfil Spring (prod para produção)
SPRING_PROFILES_ACTIVE=prod

# PostgreSQL (Railway adiciona automaticamente)
DATABASE_URL=jdbc:postgresql://<host>:<port>/<dbname>
DATABASE_USERNAME=<username>
DATABASE_PASSWORD=<password>

# CORS — URL do frontend em produção
FRONTEND_URL=https://<frontend-service-name>.up.railway.app

# Porta (Railway define automaticamente)
PORT=8080

# JWT Secret (usar valor seguro em produção)
JWT_SECRET=<gerar-seguro-com-openssl-rand-hex-64>

# ============================================
# Railway adiciona automaticamente:
# - PORT
# - DATABASE_URL, DATABASE_USERNAME, DATABASE_PASSWORD (se PostgreSQL ligado)
# ============================================
