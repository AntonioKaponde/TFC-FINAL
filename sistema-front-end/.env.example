# ============================================
# Configuração do Frontend
# ============================================

# URL da API do backend
# Em produção, aponte para o domínio do serviço backend no Railway
# Exemplo: VITE_API_URL=https://sistema-api-production.up.railway.app

# Desenvolvimento local (proxy via Vite)
VITE_API_URL=http://localhost:8080

# ============================================
# Railway (Produção)
# ============================================
# Configurar na dashboard do Railway (variáveis de serviço)
# VITE_API_URL=https://<backend-service-name>.up.railway.app
